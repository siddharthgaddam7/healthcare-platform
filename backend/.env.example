# Copy to backend/.env for local Flask (never commit .env).

# --- MongoDB Atlas (Cluster0 / healthcare_platform) ---
# Atlas → Database → Connect → Drivers → copy SRV string. Do not commit real credentials.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=healthcare_platform

# --- Flask (local) ---
# SECRET_KEY=long-random-string

# --- CORS (Render production) ---
# Exact browser origins, comma-separated, no trailing slashes, no paths.
# Example: https://my-app.vercel.app,https://my-app-git-main-xxx.vercel.app
# FRONTEND_ORIGINS=

# --- SendGrid (optional) ---
# SENDGRID_API_KEY=
# GMAIL_USER=verified-sender@yourdomain.com
# EMAIL_TEST_MODE=true

# --- Frontend (Vercel build only; set in Vercel dashboard, not in this file) ---
# CC_API_BASE_URL=https://your-render-service.onrender.com
