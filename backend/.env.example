# Copy to backend/.env for local Flask (never commit .env).

# --- MongoDB Atlas ---
# MONGO_URI=mongodb+srv://...
# MONGO_DB_NAME=healthcare_platform

# --- Flask ---
# SECRET_KEY=long-random-string

# --- CORS (Render) ---
# FRONTEND_ORIGINS=https://your-app.vercel.app

# --- Gmail SMTP (booking + /test-email) ---
# Account that logs in to smtp.gmail.com (usually your Gmail address).
# GMAIL_USER=you@gmail.com
#
# Google Account → Security → 2-Step Verification ON → App passwords → generate
# "Mail" for this app; paste the 16-character value (spaces optional).
# GMAIL_APP_PASSWORD=
#
# Every booking email is sent TO this address (lab DB email is ignored for routing).
# Defaults to siddharthgaddam34@gmail.com if unset (override for other deployments).
# BOOKING_EMAIL_TO=siddharthgaddam34@gmail.com
#
# Optional: prefix [TEST MODE] on subjects when true. On Render, omit for false.
# EMAIL_TEST_MODE=false

# --- Frontend (Vercel build) ---
# CC_API_BASE_URL=https://your-render-service.onrender.com
